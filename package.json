{
  "name": "simpletrans",
  "version": "0.3.0",
  "private": true,
  "description": "SimpleTrans Chrome extension built with React",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "npm test && npm run build && npm run smoke",
    "icons": "node scripts/gen-icons.js"
  },
  "dependencies": {
    "eventsource-parser": "^4.1.3",
    "js-md5": "^0.10.0",
    "lucide-react": "^1.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
